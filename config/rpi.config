CONFIG_RP1_PIO=m
CONFIG_WS2812_PIO_RP1=m
CONFIG_EEPROM_AT24=m
CONFIG_MFD_STMPE=y
CONFIG_STMPE_SPI=y
CONFIG_MFD_WL1273_CORE=m

# Power: regulators, reset, PoE
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
